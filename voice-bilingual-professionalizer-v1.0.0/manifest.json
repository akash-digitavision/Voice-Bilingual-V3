{
  "manifest_version": 3,
  "name": "Voice Bilingual Professionalizer",
  "version": "1.0.0",
  "description": "Voice-to-bilingual professional refinement in natural Bangla and executive English for Google Chrome.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Bilingual Professionalizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/*.js",
        "vendor/*.mjs",
        "vendor/*.wasm",
        "modules/audio-recorder-worklet.js",
        "modules/*.js",
        "icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open Voice Professionalizer Popup"
    },
    "toggle-voice-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Toggle In-Page Voice Recording Overlay"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://* http://localhost:* http://127.0.0.1:* https://huggingface.co https://*.huggingface.co https://*.hf.co https://generativelanguage.googleapis.com https://api.openai.com https://speech.googleapis.com https://api.deepgram.com https://api.assemblyai.com;"
  }
}
